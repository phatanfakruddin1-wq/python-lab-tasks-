subjects = {
    "Python": 90,
    "Java": 85,
    "C": 80,
    "HTML": 95
}

print("Keys:")
for key in subjects.keys():
    print(key)

print("\nValues:")
for value in subjects.values():
    print(value)

print("\nItems:")
for key, value in subjects.items():
    print(key, ":", value)